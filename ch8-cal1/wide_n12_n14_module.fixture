        }
    }

    #[kani::proof_for_contract(actual_merge_down_wide_n14)]
    #[kani::unwind(36)]
    fn gen_n14_wide_merge_down() {
        let mut v = wide_array::<16>();
        let v_before = v;
        let mut scratch = wide_scratch48();
        let scratch_before = scratch;
        let k = usize::from(kani::any::<u8>());
        let c = usize::from(kani::any::<u8>());
        kani::assume(k < 7 && c <= k);
        // SAFETY: The constrained source positions and all 14 destination
        // records satisfy the wrapper contract; V and D are separate arrays.
        let (down_left, down_right) = unsafe {
            (scratch_before[6 - c].assume_init(), scratch_before[13 - (k - c)].assume_init())
        };
        let takes_left = down_left.key > down_right.key;
        let expected = if takes_left { down_left } else { down_right };
        let s = v[1..15].as_mut_ptr();
        let d = scratch.as_mut_ptr().cast::<Wide>();
        // SAFETY: D[0..14] is initialized and S[0..14] is writable in
        // distinct allocations, with the counter assumptions above.
        unsafe { actual_merge_down_wide_n14(d, s, k, c) };

        kani::assert(same_wide(v[14 - k], expected), "GEN_N14_WIDE_DOWN_VALUE");
        let mut v_frame = true;
        for i in 0..16 {
            if i != 14 - k {
                v_frame &= same_wide(v[i], v_before[i]);
            }
        }
        kani::assert(v_frame, "GEN_N14_WIDE_DOWN_V_FRAME");
        kani::assert(scratch48_frame(&scratch, &scratch_before), "GEN_N14_WIDE_DOWN_SCRATCH_FRAME");
        kani::cover(takes_left, "GEN_N14_WIDE_DOWN_TAKES_LEFT");
        kani::cover(!takes_left, "GEN_N14_WIDE_DOWN_TAKES_RIGHT");
        kani::cover(
            down_left.key == down_right.key && down_left.tag != down_right.tag,
            "GEN_N14_WIDE_DOWN_TIE",
        );
        kani::cover(k == 0, "GEN_N14_WIDE_DOWN_K_ZERO");
        kani::cover(k == 6, "GEN_N14_WIDE_DOWN_K_LAST");
        kani::cover(true, "GEN_N14_WIDE_DOWN_RETURNED");
    }

    // N14 literal witness on the actual unstable Wide entry. The rest of the module ends here.
    const LEFT: Wide = Wide { key: 2, tag: 16, payload: 0x1111_2222_3333_4444 };
    const RIGHT: Wide = Wide { key: 3, tag: 17, payload: 0xaaaa_bbbb_cccc_dddd };

    const fn input_record(key: u64, tag: u64) -> Wide {
        Wide { key, tag, payload: 0x8000_0000_0000_0100 + tag }
    }

    const INPUT: [Wide; 16] = [
        LEFT,
        input_record(1, 0),
        input_record(0, 1),
        input_record(1, 2),
        input_record(0, 3),
        input_record(0, 4),
        input_record(0, 5),
        input_record(0, 6),
        input_record(1, 7),
        input_record(0, 8),
        input_record(1, 9),
        input_record(0, 10),
        input_record(0, 11),
        input_record(0, 12),
        input_record(0, 13),
        RIGHT,
    ];

    // Indices in INPUT, including its left canary at index zero.
    const EXPECTED: [Wide; 14] = [
        INPUT[2], INPUT[4], INPUT[5], INPUT[6], INPUT[7], INPUT[9], INPUT[11], INPUT[12],
        INPUT[13], INPUT[14], INPUT[1], INPUT[3], INPUT[8], INPUT[10],
    ];

    const CORRUPTED: [Wide; 14] = [
        INPUT[2], INPUT[4], INPUT[5], INPUT[6], INPUT[9], INPUT[7], INPUT[11], INPUT[12],
        INPUT[13], INPUT[14], INPUT[1], INPUT[3], INPUT[8], INPUT[10],
    ];

    fn observe(v: &[Wide; 16], expected: &[Wide; 14]) -> (bool, bool, bool) {
        let mut exact = same_wide(v[1], expected[0]);
        let mut ordered = true;
        let mut stable = true;
        for i in 1..14 {
            let (a, b) = (v[i], v[i + 1]);
            exact &= same_wide(b, expected[i]);
            ordered &= a.key <= b.key;
            stable &= a.key != b.key || a.tag < b.tag;
        }
        (ordered, exact, stable)
    }

    #[kani::proof]
    #[kani::unwind(36)]
    fn gen_n14_wide_witness_literal_corrupt() {
        let mut v = INPUT;
        let mut less = wide_less;
        <Wide as UnstableSmallSortTypeImpl>::small_sort(&mut v[1..15], &mut less);
        kani::cover(true, "AFTER_WIDE_N14_RETURN");

        let (ordered, exact, stable) = observe(&v, &EXPECTED);
        kani::assert(ordered, "GEN_N14_WIDE_BEFORE_ORDER");
        kani::assert(exact, "GEN_N14_WIDE_BEFORE_RECORDS_BY_TAG");
        kani::assert(stable, "GEN_N14_WIDE_BEFORE_STABLE_EQUAL_KEYS");
        kani::assert(
            v[5].key == 0 && v[6].key == 0 && v[5].tag == 6 && v[6].tag == 8,
            "GEN_N14_WIDE_BEFORE_SWAP_PAIR",
        );
        kani::assert(same_wide(v[0], LEFT) && same_wide(v[15], RIGHT), "GEN_N14_WIDE_BEFORE_FRAME");
        kani::cover(
            v[5].key == v[6].key && v[5].tag < 7 && v[6].tag >= 7,
            "GEN_N14_WIDE_WITNESS_CROSS_HALF_TIE",
        );

        let left = v[5];
        v[5] = v[6];
        v[6] = left;
        let (ordered, exact, stable) = observe(&v, &CORRUPTED);
        kani::assert(ordered, "GEN_N14_WIDE_AFTER_ORDER");
        kani::assert(exact, "GEN_N14_WIDE_AFTER_RECORDS_BY_TAG");
        kani::assert(same_wide(v[0], LEFT) && same_wide(v[15], RIGHT), "GEN_N14_WIDE_AFTER_FRAME");
        kani::assert(stable, "GEN_N14_WIDE_STABLE_EQUAL_KEYS");
    }
}
