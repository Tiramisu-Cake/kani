#[cfg(kani_smallsort_rev2_gen_stable_wide_n12_n14)]
mod wide_n12_n14 {
    use super::super::super::UnstableSmallSortTypeImpl;
    use super::*;

    fn wide_array<const L: usize>() -> [Wide; L] {
        let mut v = [Wide { key: 0, tag: 0, payload: 0 }; L];
        for i in 0..L {
            v[i] = any_wide();
        }
        v
    }

    fn wide_scratch48() -> [MaybeUninit<Wide>; 48] {
        let mut scratch = [MaybeUninit::<Wide>::uninit(); 48];
        for i in 0..32 {
            scratch[i].write(any_wide());
        }
        for i in 32..48 {
            scratch[i].write(any_wide());
        }
        scratch
    }

    fn scratch48_frame(
        scratch: &[MaybeUninit<Wide>; 48],
        before: &[MaybeUninit<Wide>; 48],
    ) -> bool {
        let mut frame = true;
        for i in 0..32 {
            // SAFETY: Both snapshots of this interval were initialized.
            frame &= unsafe { same_wide(scratch[i].assume_init(), before[i].assume_init()) };
        }
        for i in 32..48 {
            // SAFETY: Both snapshots of this interval were initialized.
            frame &= unsafe { same_wide(scratch[i].assume_init(), before[i].assume_init()) };
        }
        frame
    }

    #[cfg_attr(
        kani,
        kani::requires(k < 6 && a <= k),
        kani::requires(ub_checks::can_dereference(ptr::slice_from_raw_parts(d, 12))),
        kani::requires(ub_checks::can_write(ptr::slice_from_raw_parts_mut(s, 12))),
        kani::requires(!ub_checks::same_allocation(d, s)),
        kani::modifies(s.wrapping_add(k))
    )]
    unsafe fn actual_merge_up_wide_n12(d: *const Wide, s: *mut Wide, k: usize, a: usize) {
        let b = k - a;
        let mut less = wide_less;
        // SAFETY: The count bounds put both reads in initialized D halves and
        // the destination in the separate writable S allocation.
        unsafe {
            let up_left = d.add(a);
            let up_right = d.add(6 + b);
            let up_dst = s.add(k);
            kani::assert(
                ub_checks::can_dereference(up_left) && ub_checks::can_dereference(up_right),
                "GEN_N12_WIDE_UP_READ",
            );
            kani::assert(ub_checks::can_write(up_dst), "GEN_N12_WIDE_UP_WRITE");
            kani::assert(
                !ub_checks::same_allocation(up_left, up_dst)
                    && !ub_checks::same_allocation(up_right, up_dst),
                "GEN_N12_WIDE_UP_DISJOINT",
            );
            let (left, right, dst) = merge_up(up_left, up_right, up_dst, &mut less);
            let takes_left = (*up_left).key <= (*up_right).key;
            kani::assert(
                left == up_left.add(takes_left as usize)
                    && right == up_right.add((!takes_left) as usize)
                    && dst == s.add(k + 1),
                "GEN_N12_WIDE_UP_CURSORS",
            );
        }
    }

    #[kani::proof_for_contract(actual_merge_up_wide_n12)]
    #[kani::unwind(36)]
    fn gen_n12_wide_merge_up() {
        let mut v = wide_array::<14>();
        let v_before = v;
        let mut scratch = wide_scratch48();
        let scratch_before = scratch;
        let k = usize::from(kani::any::<u8>());
        let a = usize::from(kani::any::<u8>());
        kani::assume(k < 6 && a <= k);
        // SAFETY: The constrained source positions and all 12 destination
        // records satisfy the wrapper contract; V and D are separate arrays.
        let (up_left, up_right) =
            unsafe { (scratch_before[a].assume_init(), scratch_before[6 + (k - a)].assume_init()) };
        let takes_left = up_left.key <= up_right.key;
        let expected = if takes_left { up_left } else { up_right };
        let s = v[1..13].as_mut_ptr();
        let d = scratch.as_mut_ptr().cast::<Wide>();
        // SAFETY: D[0..12] is initialized and S[0..12] is writable in
        // distinct allocations, with the counter assumptions above.
        unsafe { actual_merge_up_wide_n12(d, s, k, a) };

        kani::assert(same_wide(v[1 + k], expected), "GEN_N12_WIDE_UP_VALUE");
        let mut v_frame = true;
        for i in 0..14 {
            if i != 1 + k {
                v_frame &= same_wide(v[i], v_before[i]);
            }
        }
        kani::assert(v_frame, "GEN_N12_WIDE_UP_V_FRAME");
        kani::assert(scratch48_frame(&scratch, &scratch_before), "GEN_N12_WIDE_UP_SCRATCH_FRAME");
        kani::cover(takes_left, "GEN_N12_WIDE_UP_TAKES_LEFT");
        kani::cover(!takes_left, "GEN_N12_WIDE_UP_TAKES_RIGHT");
        kani::cover(
            up_left.key == up_right.key && up_left.tag != up_right.tag,
            "GEN_N12_WIDE_UP_TIE",
        );
        kani::cover(k == 0, "GEN_N12_WIDE_UP_K_ZERO");
        kani::cover(k == 5, "GEN_N12_WIDE_UP_K_LAST");
        kani::cover(true, "GEN_N12_WIDE_UP_RETURNED");
    }

    #[cfg_attr(
        kani,
        kani::requires(k < 6 && c <= k),
        kani::requires(ub_checks::can_dereference(ptr::slice_from_raw_parts(d, 12))),
        kani::requires(ub_checks::can_write(ptr::slice_from_raw_parts_mut(s, 12))),
        kani::requires(!ub_checks::same_allocation(d, s)),
        kani::modifies(s.wrapping_add(11 - k))
    )]
    unsafe fn actual_merge_down_wide_n12(d: *const Wide, s: *mut Wide, k: usize, c: usize) {
        let d_count = k - c;
        let mut less = wide_less;
        // SAFETY: The count bounds put both reads in initialized D halves and
        // the destination in the separate writable S allocation.
        unsafe {
            let down_left = d.add(5 - c);
            let down_right = d.add(11 - d_count);
            let down_dst = s.add(11 - k);
            kani::assert(
                ub_checks::can_dereference(down_left) && ub_checks::can_dereference(down_right),
                "GEN_N12_WIDE_DOWN_READ",
            );
            kani::assert(ub_checks::can_write(down_dst), "GEN_N12_WIDE_DOWN_WRITE");
            kani::assert(
                !ub_checks::same_allocation(down_left, down_dst)
                    && !ub_checks::same_allocation(down_right, down_dst),
                "GEN_N12_WIDE_DOWN_DISJOINT",
            );
            let (left, right, dst) = merge_down(down_left, down_right, down_dst, &mut less);
            let takes_left = (*down_left).key > (*down_right).key;
            kani::assert(
                left == down_left.wrapping_sub(takes_left as usize)
                    && right == down_right.wrapping_sub((!takes_left) as usize)
                    && dst == s.add(10 - k),
                "GEN_N12_WIDE_DOWN_CURSORS",
            );
        }
    }

    #[kani::proof_for_contract(actual_merge_down_wide_n12)]
    #[kani::unwind(36)]
    fn gen_n12_wide_merge_down() {
        let mut v = wide_array::<14>();
        let v_before = v;
        let mut scratch = wide_scratch48();
        let scratch_before = scratch;
        let k = usize::from(kani::any::<u8>());
        let c = usize::from(kani::any::<u8>());
        kani::assume(k < 6 && c <= k);
        // SAFETY: The constrained source positions and all 12 destination
        // records satisfy the wrapper contract; V and D are separate arrays.
        let (down_left, down_right) = unsafe {
            (scratch_before[5 - c].assume_init(), scratch_before[11 - (k - c)].assume_init())
        };
        let takes_left = down_left.key > down_right.key;
        let expected = if takes_left { down_left } else { down_right };
        let s = v[1..13].as_mut_ptr();
        let d = scratch.as_mut_ptr().cast::<Wide>();
        // SAFETY: D[0..12] is initialized and S[0..12] is writable in
        // distinct allocations, with the counter assumptions above.
        unsafe { actual_merge_down_wide_n12(d, s, k, c) };

        kani::assert(same_wide(v[12 - k], expected), "GEN_N12_WIDE_DOWN_VALUE");
        let mut v_frame = true;
        for i in 0..14 {
            if i != 12 - k {
                v_frame &= same_wide(v[i], v_before[i]);
            }
        }
        kani::assert(v_frame, "GEN_N12_WIDE_DOWN_V_FRAME");
        kani::assert(scratch48_frame(&scratch, &scratch_before), "GEN_N12_WIDE_DOWN_SCRATCH_FRAME");
        kani::cover(takes_left, "GEN_N12_WIDE_DOWN_TAKES_LEFT");
        kani::cover(!takes_left, "GEN_N12_WIDE_DOWN_TAKES_RIGHT");
        kani::cover(
            down_left.key == down_right.key && down_left.tag != down_right.tag,
            "GEN_N12_WIDE_DOWN_TIE",
        );
        kani::cover(k == 0, "GEN_N12_WIDE_DOWN_K_ZERO");
        kani::cover(k == 5, "GEN_N12_WIDE_DOWN_K_LAST");
        kani::cover(true, "GEN_N12_WIDE_DOWN_RETURNED");
    }

    #[cfg_attr(
        kani,
        kani::requires(k < 7 && a <= k),
        kani::requires(ub_checks::can_dereference(ptr::slice_from_raw_parts(d, 14))),
        kani::requires(ub_checks::can_write(ptr::slice_from_raw_parts_mut(s, 14))),
